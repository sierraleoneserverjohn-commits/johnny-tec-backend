# ==========================================
# SIERRA LEONE SERVER (SLS) GLOBAL CONFIG
# ==========================================

# 1. Platform Mode: linux | termux | docker
PLATFORM_MODE=linux
NODE_ENV=production

# 2. Workspace Ports
API_PORT=4000
DAEMON_PORT=4001
DASHBOARD_PORT=3000

# 3. Security Secrets
JWT_SECRET=sls_production_super_secret_key_change_immediately

# 4. PostgreSQL Database
POSTGRES_USER=sls_admin
POSTGRES_PASSWORD=sls_secure_password
POSTGRES_DB=sls_core
DATABASE_URL=postgres://sls_admin:sls_secure_password@localhost:5432/sls_core

# 5. Redis Cache
REDIS_URL=redis://localhost:6379

# 6. System Execution Paths
NGINX_SITES_PATH=/etc/nginx/conf.d
